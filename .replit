modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
# Must be long enough for install + the dev-DB mirror + drizzle push. At 20s the
# mirror step was being starved, leaving dev missing runtime-created tables — which
# makes Publish propose DROP TABLE on them. The script orders itself defensively too.
timeoutMs = 180000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 19661
externalPort = 3000

[nix]
channel = "stable-25_05"
